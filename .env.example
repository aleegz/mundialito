# Supabase — Dashboard → Project Settings → API Keys
#
# Estas dos son las UNICAS variables que la app lee (src/lib/supabase/*
# server.ts, client.ts y middleware.ts). Copiá este archivo a `.env.local`
# y completá los valores.

# URL del proyecto, ej. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (publishable / anon).
# OJO: todo lo que empieza con NEXT_PUBLIC_ viaja al browser. La service
# role key NO va acá nunca: se salta RLS y no debe existir en el cliente.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
